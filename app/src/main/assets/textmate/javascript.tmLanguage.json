{
  "name": "JavaScript",
  "scopeName": "source.js",
  "fileTypes": ["js", "jsx"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#keyword" },
    { "include": "#function" },
    { "include": "#number" }
  ],
  "repository": {
    "comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.js"
    },
    "string": {
      "begin": "'",
      "end": "'",
      "name": "string.quoted.single.js"
    },
    "keyword": {
      "match": "\\b(const|let|var|function|return|if|else|for|while|class|import|export|from|default|new|this|true|false|null|undefined)\\b",
      "name": "keyword.control.js"
    },
    "function": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "name": "entity.name.function.js"
    },
    "number": {
      "match": "\\b\\d+(\\.\\d+)?\\b",
      "name": "constant.numeric.js"
    }
  }
}

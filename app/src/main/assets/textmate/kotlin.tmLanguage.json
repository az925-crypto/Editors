{
  "name": "Kotlin",
  "scopeName": "source.kotlin",
  "fileTypes": ["kt", "kts"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#keyword" },
    { "include": "#function" },
    { "include": "#number" },
    { "include": "#annotation" }
  ],
  "repository": {
    "comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.kotlin"
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.kotlin"
    },
    "keyword": {
      "match": "\\b(fun|val|var|class|interface|object|if|else|when|for|while|return|import|package|override|private|public|internal|protected|sealed|data|companion|suspend|inline|null|true|false|this|super|is|as|in|it)\\b",
      "name": "keyword.control.kotlin"
    },
    "function": {
      "match": "\\b(fun)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": { "2": { "name": "entity.name.function.kotlin" } }
    },
    "number": {
      "match": "\\b\\d+(\\.\\d+)?[Lf]?\\b",
      "name": "constant.numeric.kotlin"
    },
    "annotation": {
      "match": "@[a-zA-Z_][a-zA-Z0-9_]*",
      "name": "storage.type.annotation.kotlin"
    }
  }
}
